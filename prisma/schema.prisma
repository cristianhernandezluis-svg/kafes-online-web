generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoProducto {
  BORRADOR
  PUBLICADO
  OCULTO
  AGOTADO
  ARCHIVADO
}

enum EstadoPedido {
  NUEVO
  CONFIRMADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum EstadoPago {
  PENDIENTE
  ADELANTO
  PAGADO
  REEMBOLSADO
}

enum MetodoPago {
  CONTRA_ENTREGA
  YAPE
  PLIN
  TRANSFERENCIA
  EFECTIVO
  OTRO
}

enum EstadoEnvio {
  PENDIENTE
  PREPARANDO
  DESPACHADO
  EN_TRANSITO
  ENTREGADO
  DEVUELTO
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String
  slug        String     @unique
  descripcion String?
  imagenUrl   String?
  activa      Boolean    @default(true)
  orden       Int        @default(0)
  productos   Producto[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categorias")
}

model Marca {
  id          Int        @id @default(autoincrement())
  nombre      String
  slug        String     @unique
  descripcion String?
  logoUrl     String?
  activa      Boolean    @default(true)
  productos   Producto[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("marcas")
}

model Producto {
  id               Int                    @id @default(autoincrement())
  nombre           String
  slug             String                 @unique
  sku              String?                @unique
  descripcionCorta String?
  descripcion      String?
  contenidoHtml    String?                @db.Text
  precio           Decimal                @db.Decimal(10, 2)
  precioAntes      Decimal?               @db.Decimal(10, 2)
  stock            Int                    @default(0)
  estado           EstadoProducto         @default(BORRADOR)
  destacado        Boolean                @default(false)
  categoriaId      Int?
  marcaId          Int?
  seoTitulo        String?
  seoDescripcion   String?
  publishedAt      DateTime?
  categoria        Categoria?             @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  marca            Marca?                 @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  imagenes         ProductoImagen[]
  beneficios       ProductoBeneficio[]
  fichaTecnica     ProductoFichaTecnica[]
  documentos       ProductoDocumento[]
  accesorios       ProductoAccesorio[]
  opiniones        Opinion[]
  secciones        ProductoSeccion[]
  itemsPedido      PedidoItem[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([categoriaId])
  @@index([marcaId])
  @@index([estado])
  @@index([destacado])
  @@map("productos")
}

model ProductoImagen {
  id          Int      @id @default(autoincrement())
  productoId  Int
  url         String
  publicId    String?
  alt         String?
  orden       Int      @default(0)
  esPrincipal Boolean  @default(false)
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productoId])
  @@index([productoId, orden])
  @@map("producto_imagenes")
}

model ProductoBeneficio {
  id          Int      @id @default(autoincrement())
  productoId  Int
  titulo      String
  descripcion String?
  icono       String?
  orden       Int      @default(0)
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productoId, orden])
  @@map("producto_beneficios")
}

model ProductoFichaTecnica {
  id         Int      @id @default(autoincrement())
  productoId Int
  nombre     String
  valor      String
  orden      Int      @default(0)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productoId, orden])
  @@map("producto_ficha_tecnica")
}

model ProductoDocumento {
  id         Int      @id @default(autoincrement())
  productoId Int
  titulo     String
  tipo       String
  archivoUrl String
  publicId   String?
  orden      Int      @default(0)
  visible    Boolean  @default(true)
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productoId, orden])
  @@index([productoId, tipo])
  @@map("producto_documentos")
}

model ProductoAccesorio {
  id          Int      @id @default(autoincrement())
  productoId  Int
  nombre      String
  descripcion String?
  imagenUrl   String?
  incluido    Boolean  @default(true)
  orden       Int      @default(0)
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productoId, orden])
  @@map("producto_accesorios")
}

model ProductoSeccion {
  id            Int      @id @default(autoincrement())
  productoId    Int
  tipo          String
  titulo        String?
  subtitulo     String?
  contenido     String?
  imagenUrl     String?
  videoUrl      String?
  configuracion Json?
  orden         Int      @default(0)
  visible       Boolean  @default(true)
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([productoId, orden])
  @@map("producto_secciones")
}

model Administrador {
  id           Int      @id @default(autoincrement())
  nombre       String?
  email        String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tokensRecuperacion TokenRecuperacion[]

  @@map("administradores")
}

model TokenRecuperacion {
  id              Int      @id @default(autoincrement())
  codigoHash      String
  administradorId Int
  expiraEn        DateTime
  utilizado       Boolean  @default(false)
  intentos        Int      @default(0)
  createdAt       DateTime @default(now())

  administrador Administrador @relation(fields: [administradorId], references: [id], onDelete: Cascade)

  @@index([administradorId])
  @@index([expiraEn])
  @@map("tokens_recuperacion")
}

model Cliente {
  id         Int     @id @default(autoincrement())
  nombre     String
  telefono   String
  email      String?
  dni        String?
  ciudad     String?
  region     String?
  direccion  String?
  referencia String?
  notas      String? @db.Text
  activo     Boolean @default(true)

  pedidos Pedido[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nombre])
  @@index([telefono])
  @@index([createdAt])
  @@map("clientes")
}

model Pedido {
  id     Int    @id @default(autoincrement())
  codigo String @unique

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  nombreCliente   String
  telefonoCliente String
  emailCliente    String?
  dniCliente      String?

  region     String?
  ciudad     String
  direccion  String
  referencia String?

  estado      EstadoPedido @default(NUEVO)
  estadoPago  EstadoPago   @default(PENDIENTE)
  metodoPago  MetodoPago   @default(CONTRA_ENTREGA)
  estadoEnvio EstadoEnvio  @default(PENDIENTE)

  subtotal       Decimal @db.Decimal(10, 2)
  descuento      Decimal @default(0) @db.Decimal(10, 2)
  costoEnvio     Decimal @default(0) @db.Decimal(10, 2)
  total          Decimal @db.Decimal(10, 2)
  montoAdelanto  Decimal @default(0) @db.Decimal(10, 2)
  montoPendiente Decimal @default(0) @db.Decimal(10, 2)

  agenciaEnvio  String?
  codigoEnvio   String?
  observaciones String? @db.Text
  notasInternas String? @db.Text

  confirmadoAt DateTime?
  enviadoAt    DateTime?
  entregadoAt  DateTime?
  canceladoAt  DateTime?

  items     PedidoItem[]
  historial PedidoHistorial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@index([codigo])
  @@index([telefonoCliente])
  @@index([estado])
  @@index([estadoPago])
  @@index([estadoEnvio])
  @@index([createdAt])
  @@map("pedidos")
}

model PedidoItem {
  id         Int  @id @default(autoincrement())
  pedidoId   Int
  productoId Int?

  nombreProducto String
  skuProducto    String?
  imagenUrl      String?

  precioUnitario Decimal @db.Decimal(10, 2)
  cantidad       Int     @default(1)
  subtotal       Decimal @db.Decimal(10, 2)

  pedido   Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pedidoId])
  @@index([productoId])
  @@map("pedido_items")
}

model PedidoHistorial {
  id          Int     @id @default(autoincrement())
  pedidoId    Int
  accion      String
  descripcion String?
  estadoAntes String?
  estadoNuevo String?
  autor       String?

  pedido Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([pedidoId])
  @@index([createdAt])
  @@map("pedido_historial")
}

model DispositivoPush {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.Text
  nombre    String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo])
}

model Banner {
  id                    Int      @id @default(autoincrement())
  titulo                String?
  subtitulo             String?
  textoBoton            String?
  href                  String   @default("/")
  alt                   String
  imagenDesktopUrl      String
  imagenDesktopPublicId String
  imagenMobileUrl       String?
  imagenMobilePublicId  String?
  activo                Boolean  @default(true)
  orden                 Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([activo, orden])
  @@map("banners")
}

model HomeSection {
  id            Int      @id @default(autoincrement())
  tipo          String
  nombre        String
  titulo        String?
  subtitulo     String?
  configuracion Json?
  orden         Int      @default(0)
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([activo, orden])
  @@index([tipo])
  @@map("home_sections")
}

model Opinion {
  id               Int      @id @default(autoincrement())
  productoId       Int
  clienteNombre    String
  ciudad           String?
  comentario       String   @db.Text
  calificacion     Int      @default(5)
  imagenUrl        String?
  imagenPublicId   String?
  compraVerificada Boolean  @default(true)
  visible          Boolean  @default(true)
  orden            Int      @default(0)
  fecha            DateTime @default(now())
  producto         Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([productoId])
  @@index([productoId, visible, orden])
  @@index([visible])
  @@index([fecha])
  @@map("opiniones")
}

model ConfiguracionTienda {
  id Int @id @default(1)

  nombreTienda String  @default("KAFES ONLINE")
  razonSocial  String?
  ruc          String?

  telefono        String?
  whatsapp        String?
  whatsappMensaje String?
  email           String?
  direccion       String?
  horarioAtencion String?

  logoUrl      String?
  logoPublicId String?

  moneda        String @default("PEN")
  simboloMoneda String @default("S/")

  facebookUrl  String?
  instagramUrl String?
  tiktokUrl    String?
  youtubeUrl   String?

  textoFooter String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("configuracion_tienda")
}

model AsesorWhatsApp {
  id             Int     @id @default(autoincrement())
  nombre         String
  cargo          String?
  telefono       String
  imagenUrl      String?
  imagenPublicId String?
  activo         Boolean @default(true)
  orden          Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo, orden])
  @@map("asesores_whatsapp")
}
